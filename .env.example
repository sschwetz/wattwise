# Copy to .env and fill in before running `docker compose up`.

# Pins Compose's project name (and therefore the data volume / container /
# network prefixes) explicitly rather than relying on the checkout
# directory's basename.
COMPOSE_PROJECT_NAME=wattwise

# A long random secret used to sign login JWTs. Generate one with, e.g.:
#   openssl rand -hex 32
JWT_SECRET=
# Encrypts device tokens and passwords stored in the database. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Back it up: losing it makes those stored values unreadable.
SECRETS_ENCRYPTION_KEY=

# Shared secrets, one per collector kind -- the SAME value goes into both
# core-api's environment and that collector's environment (docker-compose
# substitutes each from this single .env entry into both places). Generate
# each with, e.g.: openssl rand -hex 32
ENVOY_COLLECTOR_KEY=
WEATHER_COLLECTOR_KEY=
PRICING_COLLECTOR_KEY=

# The public origin the webapp is served from, and the one core-api trusts
# for CORS + password-reset links. Defaults to http://localhost for local
# testing; set to your real domain in a real deployment.
FRONTEND_BASE_URL=http://localhost

# The public origin the browser should call core-api at. Defaults to
# http://localhost:8000 for local testing. The browser calls core-api
# directly, so to use WattWise away from home this must be an https:// address
# reachable from the internet.
API_BASE_URL=http://localhost:8000

# HTTPS through the bundled Caddy reverse proxy (see README, "HTTPS and access
# from outside"). Uncomment all four lines, replace the hostname, and delete the
# FRONTEND_BASE_URL and API_BASE_URL lines above so each is set once. With
# Caddy's one-hostname layout, the two URLs are the same.
# WATTWISE_DOMAIN=wattwise.example.com
# FRONTEND_BASE_URL=https://wattwise.example.com
# API_BASE_URL=https://wattwise.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:deploy/caddy/docker-compose.caddy.yml

SMTP_FROM=noreply@localhost

# mail-relay: outbound-only Postfix relay used for password-reset emails.
RELAY_DOMAIN=example.com
RELAY_SMARTHOST=[smtp.yourprovider.example]:587
RELAY_USERNAME=
RELAY_PASSWORD=
