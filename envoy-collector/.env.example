CORE_API_URL=http://localhost:8000
COLLECTOR_KEY=change-me
POLL_INTERVAL_SECONDS=60
DISCOVERY_REFRESH_SECONDS=300
# Live-data sampling (defaults shown): seconds between gateway reads, and
# seconds without a new reading before a minute falls back to single polls
# LIVE_SAMPLE_SECONDS=3
# LIVE_STALE_SECONDS=30
# Where live minutes take battery figures from: "ensemble" (/ivp/ensemble/power,
# the default until the battery sign check passes) or "livedata" (the live feed)
# LIVE_BATTERY_SOURCE=ensemble
