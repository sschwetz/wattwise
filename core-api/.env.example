DATABASE_URL=sqlite:///./core_api.db
JWT_SECRET=change-me-to-a-long-random-value
# A Fernet key (see ../.env.example for how to generate one).
SECRETS_ENCRYPTION_KEY=
JWT_EXPIRY_HOURS=24
SMTP_HOST=mail-relay
SMTP_PORT=25
SMTP_FROM=noreply@localhost
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:5173
# Runs the periodic jobs (demand intervals, demand charges, retention rollup)
# in-process. Defaults to enabled; set false to run them elsewhere.
SCHEDULER_ENABLED=true
