DATABASE_URL=sqlite:///./core_api.db
JWT_SECRET=change-me-to-a-long-random-value
# A Fernet key (see ../.env.example for how to generate one).
SECRETS_ENCRYPTION_KEY=
JWT_EXPIRY_HOURS=24
SMTP_HOST=mail-relay
SMTP_PORT=25
SMTP_FROM=noreply@localhost
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:5173
# Runs the periodic jobs (demand intervals, demand charges, retention rollup)
# in-process. Defaults to enabled; set false to run them elsewhere.
SCHEDULER_ENABLED=true
# Shared keys, one per calling service. Core API refuses to start without them.
# Generate each with: openssl rand -hex 32. Use a different value for each.
ENVOY_COLLECTOR_KEY=change-me
WEATHER_COLLECTOR_KEY=change-me
PRICING_COLLECTOR_KEY=change-me
ACTOR_KEY=change-me
MAIL_ACTOR_KEY=change-me
# Optional settings and their defaults.
# Email of the first user, created on an empty database.
# ADMIN_EMAIL=admin@example.com
# Prefix for the /docs, /redoc and /openapi.json pages behind a proxy, for example /api.
# ROOT_PATH=
# Directory where uploaded avatars are stored.
# AVATAR_STORAGE_DIR=./data/avatars
# Where the service_status job fetches the webapp's /version. Defaults to FRONTEND_BASE_URL.
# WEBAPP_VERSION_URL=
